rules_version = '2';

// Dr. Rashia Biology Academy - Cloud Firestore security rules.
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isTeacher() { return signedIn() && profile().role == 'teacher'; }
    function myKids() { return profile().get('childIds', []); }
    // The signed-in user is the student, or a parent of the student.
    function isMineOrMyChild(studentId) {
      return signedIn() && (studentId == request.auth.uid || studentId in myKids());
    }

    // Profiles: you, your children, or everyone if you are the teacher.
    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isTeacher() || uid in myKids());
      allow create, update, delete: if isTeacher();
    }

    // Video lessons: any signed-in user may list them (premium gating happens in
    // the app; put the real video files behind signed URLs for strict secrecy).
    match /lessons/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    // Subscriptions.
    match /subscriptions/{id} {
      allow read: if isTeacher() || isMineOrMyChild(resource.data.studentId);
      allow create: if isTeacher() || (
        // Self-service creation is only allowed for a code the student just claimed.
        isMineOrMyChild(request.resource.data.studentId) &&
        request.resource.data.source == 'code' &&
        get(/databases/$(database)/documents/codes/$(request.resource.data.codeId)).data.usedBy
          == request.resource.data.studentId
      );
      allow update, delete: if isTeacher();
    }

    // Activation codes: single lookups by signed-in users, list only for the teacher.
    match /codes/{code} {
      allow get: if signedIn();
      allow list, create, delete: if isTeacher();
      // Claiming: set usedBy/usedAt once, nothing else may change.
      allow update: if isTeacher() || (
        signedIn() &&
        resource.data.usedBy == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt']) &&
        isMineOrMyChild(request.resource.data.usedBy)
      );
    }

    // Lesson watch progress.
    match /progress/{id} {
      allow read: if isTeacher() || isMineOrMyChild(resource.data.studentId);
      allow create, update: if isTeacher() || (signedIn() && request.resource.data.studentId == request.auth.uid);
    }
  }
}
